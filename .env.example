# Keep this file free of real credentials. Copy it to .env and fill in your own.

# ---------- Otari (required) ----------
# A workspace API key, or (for per-contributor budgets) an organization service key.
OTARI_API_KEY=
# EU accounts use https://eu.api.otari.ai/api/v1
OTARI_BASE_URL=https://api.otari.ai/api/v1

# ---------- Models per role ----------
# Each role may be a concrete open-weight model or an Otari routing policy name.
# Unset = the verified default. After creating the policies in docs/OTARI-SETUP.md set:
#   LITMUS_MODEL_SCOUT=litmus-scout
#   LITMUS_MODEL_REVIEWER=litmus-reviewer
#   LITMUS_MODEL_RESEARCHER=litmus-researcher
# If Otari does not recognise a policy name, Litmus uses the role's default model and
# shows "routing policy not configured" in the Otari view.
LITMUS_MODEL_SCOUT=groq:openai/gpt-oss-20b
LITMUS_MODEL_REVIEWER=openrouter:openai/gpt-oss-120b
LITMUS_MODEL_RESEARCHER=moonshotai/kimi-k2-instruct-0905
# Optional per-role repository-context budgets in characters (scout stays small for Groq's free tier).
# LITMUS_CONTEXT_CHARS_SCOUT=12000
# LITMUS_CONTEXT_CHARS_REVIEWER=90000
# json_schema (default: strict, then json_object fallback) or json_object (skip strict entirely).
# LITMUS_STRUCTURED_MODE=json_schema

# ---------- Per-user budgets ----------
# auto (default): send the GitHub login as `user`; if the key is not a service key, fall back
# to a request tag. service: always send `user`. tag: never send `user`.
LITMUS_END_USER_MODE=auto
# End-user budget ids from Otari (Spend & budgets). Sent as Otari-End-User-Budget when a new
# contributor / maintainer first appears. Leave blank to use the service key's default budget.
LITMUS_BUDGET_CONTRIBUTOR=
LITMUS_BUDGET_MAINTAINER=
# Maintainer identity for maintainer tasks. Default: the repository owner.
# LITMUS_MAINTAINER_ID=

# ---------- Guardrails on untrusted human text ----------
LITMUS_GUARDRAILS=on
# The profile name your Otari organization mandates or defines (docs/OTARI-SETUP.md step 5).
LITMUS_GUARDRAIL_PROFILE=prompt-injection
LITMUS_GUARDRAIL_MODE=block
# monitor: serve the request when the guardrail cannot run (recorded as "unavailable").
# block: refuse it (fail closed). Use block once a guardrail is configured.
LITMUS_GUARDRAIL_ON_UNAVAILABLE=monitor

# ---------- Tools (researcher role and plan sandbox) ----------
# Otari web fetch on links found in an issue or plan.
LITMUS_WEB_FETCH=on
# Also offer Otari web search (max 2 searches per call).
LITMUS_WEB_SEARCH=off
# Workspace MCP server ids (Tools -> MCP servers), comma-separated, e.g. DeepWiki and GitHub.
LITMUS_MCP_SERVER_IDS=
# Inline MCP servers by name. Supported: deepwiki. Needs request MCP servers allowed on the workspace.
LITMUS_MCP_INLINE=
LITMUS_MAX_TOOL_ITERATIONS=4
# Run fenced code snippets from a contributor's plan in Otari's code sandbox.
LITMUS_CODE_EXEC=off

# ---------- App ----------
LITMUS_PORT=4173
# LITMUS_DATA_DIR=./data
# LITMUS_OTARI_TIMEOUT_MS=180000
# Reading GitHub (repos, issues, PRs). A classic PAT with public_repo scope is enough.
GITHUB_TOKEN=
# Posting bot comments to GitHub is off by default: questions and assessments are
# previewed in Litmus. Set to "on" to post them as the GITHUB_TOKEN account.
LITMUS_GITHUB_POSTING=off
