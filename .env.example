# Keep this file free of real credentials.
OTARI_API_KEY=
# EU accounts use https://eu.api.otari.ai/api/v1
OTARI_BASE_URL=https://api.otari.ai/api/v1
OTARI_MODEL=openrouter:openai/gpt-oss-120b
LITMUS_PORT=4173
# Reading GitHub (repos, issues, PRs). A classic PAT with public_repo scope is enough.
GITHUB_TOKEN=
# Posting bot comments to GitHub is off by default: questions and assessments are
# previewed in Litmus. Set to "on" to post them as the GITHUB_TOKEN account.
LITMUS_GITHUB_POSTING=off
